# Copy to .env only for local experiments; never commit real values.
# In production these are GitHub Actions secrets / variables (see README).

# Text model. In Actions, GITHUB_TOKEN is provided automatically (free GitHub Models).
GITHUB_TOKEN=
# Optional, paid: use Claude instead of GitHub Models.
ANTHROPIC_API_KEY=
# Optional: override the default model name.
AI_MODEL=

# Cloudflare: deploys to Pages (required in CI) and makes the free AI pictures (optional locally).
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Optional: public site address (defaults to https://aiagentnewsfree.com).
SITE_URL=
