# Copy to .env only for local experiments; never commit real values.
# In production these are GitHub Actions secrets / variables (see README).

# Optional, paid: use Claude instead of Cloudflare Workers AI for text.
ANTHROPIC_API_KEY=
# Optional: override the text model (default @cf/meta/llama-3.3-70b-instruct-fp8-fast).
AI_MODEL=

# Cloudflare: deploys to Pages and runs the free AI for text (Llama 3.3) and pictures (FLUX).
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Optional: public site address (defaults to https://aiagentnewsfree.com).
SITE_URL=
